{
  "name": "cedarview-house",
  "private": true,
  "description": "Single-property site for 709 Cedarview Dr, Blacksburg, VA \u2014 cedarview.house",
  "scripts": {
    "images": "node scripts/build-images.mjs && node scripts/build-album.mjs",
    "pdf": "python3 pdf/build_spec_sheet.py && python3 pdf/build_plans.py",
    "page": "node scripts/build-page.mjs",
    "check": "node scripts/check-launch.mjs",
    "build": "npm run images && npm run pdf && npm run page && npm run check",
    "review": "PREVIEW_TBC=1 PAGE_OUT=review.html node scripts/build-page.mjs",
    "serve": "python3 -m http.server 8080",
    "lighthouse": "node scripts/lighthouse.mjs",
    "map-image": "node scripts/map-image.mjs"
  },
  "devDependencies": {
    "leaflet": "^1.9.4",
    "sharp": "^0.35.5"
  }
}
